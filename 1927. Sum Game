class Solution {
    public boolean sumGame(String num) {
        int n = num.length();

        int diff = 0;
        int leftQ = 0;
        int rightQ = 0;

        // First half
        for (int i = 0; i < n / 2; i++) {
            char c = num.charAt(i);

            if (c == '?') {
                leftQ++;
            } else {
                diff += c - '0';
            }
        }

        // Second half
        for (int i = n / 2; i < n; i++) {
            char c = num.charAt(i);

            if (c == '?') {
                rightQ++;
            } else {
                diff -= c - '0';
            }
        }

        // Bob wins only if the difference can be
        // exactly compensated by the '?' positions.
        return 2 * diff != 9 * (rightQ - leftQ);
    }
}
