class Solution {
    public int longestValidParentheses(String s) {

        int n = s.length();
        int[] dp = new int[n];

        int maxLength = 0;

        for (int i = 1; i < n; i++) {

            if (s.charAt(i) == ')') {

                // Case 1: "()"
                if (s.charAt(i - 1) == '(') {

                    dp[i] = 2;

                    if (i >= 2) {
                        dp[i] += dp[i - 2];
                    }
                }

                // Case 2: "(...))"
                else {

                    int matchingIndex = i - dp[i - 1] - 1;

                    if (matchingIndex >= 0 &&
                        s.charAt(matchingIndex) == '(') {

                        dp[i] = dp[i - 1] + 2;

                        if (matchingIndex >= 1) {
                            dp[i] += dp[matchingIndex - 1];
                        }
                    }
                }

                maxLength = Math.max(maxLength, dp[i]);
            }
        }

        return maxLength;
    }
}
