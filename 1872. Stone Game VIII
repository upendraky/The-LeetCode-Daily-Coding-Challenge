class Solution {
    public int stoneGameVIII(int[] stones) {
        int n = stones.length;

        // Build prefix sums
        int[] prefix = new int[n];
        prefix[0] = stones[0];

        for (int i = 1; i < n; i++) {
            prefix[i] = prefix[i - 1] + stones[i];
        }

        // Initially, Alice can take all stones
        int ans = prefix[n - 1];

        // Process possible moves from right to left
        for (int i = n - 2; i >= 1; i--) {
            ans = Math.max(ans, prefix[i] - ans);
        }

        return ans;
    }
}
