class Solution {
    public int smallestIndex(int[] nums) {
        // Iterate through the array from the smallest index to the largest
        for (int i = 0; i < nums.length; i++) {
            // Check if the digit sum matches the current index
            if (getDigitSum(nums[i]) == i) {
                return i; 
            }
        }
        // Return -1 if no such index is found
        return -1;
    }

    // Helper method to calculate the sum of digits of a number
    private int getDigitSum(int num) {
        int sum = 0;
        while (num > 0) {
            sum += num % 10;
            num /= 10;
        }
        return sum;
    }
}
