
class Solution {
    public long minSumSquareDiff(int[] nums1, int[] nums2,
                                 int k1, int k2) {

        long operations = (long) k1 + k2;
        int[] count = new int[100001];
        int maxDiff = 0;

        for (int i = 0; i < nums1.length; i++) {
            int diff = Math.abs(nums1[i] - nums2[i]);
            count[diff]++;
            maxDiff = Math.max(maxDiff, diff);
        }

        // Reduce the largest differences first
        for (int d = maxDiff; d > 0 && operations > 0; d--) {
            long available = count[d];
            long used = Math.min(operations, available);

            count[d] -= (int) used;
            count[d - 1] += (int) used;
            operations -= used;
        }

        long result = 0;

        for (int d = 1; d < count.length; d++) {
            result += (long) d * d * count[d];
        }

        return result;
    }
}
