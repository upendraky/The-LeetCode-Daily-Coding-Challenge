class Solution {
    public int numberOfSets(int n, int k) {
        final long MOD = 1_000_000_007L;

        long[][] dp = new long[n][k + 1];

        // 0 segments can always be chosen in exactly 1 way.
        for (int i = 0; i < n; i++) {
            dp[i][0] = 1;
        }

        for (int j = 1; j <= k; j++) {
            long sum = 0;

            for (int i = 1; i < n; i++) {

                // Add possible starting positions.
                sum = (sum + dp[i - 1][j - 1]) % MOD;

                // Either don't end a segment at i,
                // or end one of the currently possible segments.
                dp[i][j] = (dp[i - 1][j] + sum) % MOD;
            }
        }

        return (int) dp[n - 1][k];
    }
}
