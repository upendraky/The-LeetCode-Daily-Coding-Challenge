class Solution {
    public int maxPalindromes(String s, int k) {
        int n = s.length();
        int count = 0;
        // Tracks the end index (+1) of the last selected palindrome
        int lastEnd = 0; 

        for (int i = 0; i < n; i++) {
            // Check for odd-length palindromes centered at i
            int l1 = i, r1 = i;
            while (l1 >= lastEnd && r1 < n && s.charAt(l1) == s.charAt(r1)) {
                if (r1 - l1 + 1 >= k) {
                    count++;
                    lastEnd = r1 + 1;
                    break; // Move to the next valid start position
                }
                l1--;
                r1++;
            }

            // Check for even-length palindromes centered between i and i+1
            // Only check if we didn't already find a valid one ending closer/earlier
            int l2 = i, r2 = i + 1;
            while (l2 >= lastEnd && r2 < n && s.charAt(l2) == s.charAt(r2)) {
                if (r2 - l2 + 1 >= k) {
                    count++;
                    lastEnd = r2 + 1;
                    break;
                }
                l2--;
                r2++;
            }
        }

        return count;
    }
}
