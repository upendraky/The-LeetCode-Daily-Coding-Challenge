class Solution {
    public String lexGreaterPermutation(String s, String target) {
        int n = s.length();

        int[] freq = new int[26];

        for (char c : s.toCharArray()) {
            freq[c - 'a']++;
        }

        char[] t = target.toCharArray();

        // Store the frequency state after matching the prefix.
        int[] bestFreq = null;
        int bestPos = -1;
        int bestChar = -1;

        for (int i = 0; i < n; i++) {
            int cur = t[i] - 'a';

            // Try to increase this position.
            for (int c = cur + 1; c < 26; c++) {
                if (freq[c] > 0) {
                    bestPos = i;
                    bestChar = c;
                    bestFreq = freq.clone();

                    // Smallest greater character is enough.
                    break;
                }
            }

            // Continue matching target[i].
            if (freq[cur] == 0) {
                break;
            }

            freq[cur]--;
        }

        if (bestPos == -1) {
            return "";
        }

        StringBuilder ans = new StringBuilder();

        // Keep prefix equal to target.
        for (int i = 0; i < bestPos; i++) {
            ans.append(t[i]);
        }

        // Put the smallest possible greater character.
        ans.append((char) ('a' + bestChar));
        bestFreq[bestChar]--;

        // Fill the suffix in sorted order.
        for (int c = 0; c < 26; c++) {
            while (bestFreq[c] > 0) {
                ans.append((char) ('a' + c));
                bestFreq[c]--;
            }
        }

        return ans.toString();
    }
}
